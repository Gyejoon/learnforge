{
  "name": "learnforge",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first AI learning system with FSRS-6 spaced repetition",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "main": "dist/core/index.js",
  "bin": {
    "learnforge": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./mcp": "./dist/adapters/mcp.js",
    "./http": "./dist/adapters/http.js"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsx src/adapters/mcp.ts",
    "dev:http": "tsx src/adapters/http.ts",
    "dev:cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.2",
    "commander": "^14.0.3",
    "pdf-parse": "^1.1.1",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
